// Cloudflare Workers configuration (see docs/cloudflare-migration/spec.md).
// Local dev runs through @cloudflare/vite-plugin with Miniflare's local
// D1/R2 simulation — no Cloudflare account needed. The GITHUB_TOKEN
// secret is NOT set here: `wrangler secret put GITHUB_TOKEN` in
// production, absent locally so issue filing stays a no-op in dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo",
  "main": "./server.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    // Built frontend (dist/) with SPA fallback so /todo deep links
    // resolve to index.html. The Worker runs first for the API and for
    // "/" (the root→/todo redirect) and /favicon.ico (redirects to the
    // SVG); everything else is served straight from assets.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/favicon.ico"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo",
      // The production database (Phase 2 import lives here). Local dev
      // still uses Miniflare's local D1 simulation, not this database.
      "database_id": "edc47bcd-5772-454f-9b62-61942c627f0c",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "todo-reports",
    },
  ],
  "vars": {
    "REPORTS_REPO": "j-alicia-long/todo-now",
  },
}
