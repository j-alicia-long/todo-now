{
  "name": "todo",
  "type": "module",
  "scripts": {
    "clear-cache": "rm -rf node_modules/.vite",
    "dev": "bun run clear-cache && bunx vite dev",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "build": "bun run clear-cache && bunx vite build",
    "preview": "bunx vite preview",
    "prepare": "husky",
    "sync-skills": "cp -R node_modules/@j-alicia-long/web-config/skills/web-conventions .github/skills/",
    "postinstall": "bun run sync-skills"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "hono": "^4.10.6",
    "marked": "^17.0.1",
    "material-symbols": "^0.45.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.8.0",
    "reveal.js": "^5.2.1",
    "sass": "^1.101.0",
    "sonner": "^2.0.7",
    "vite": "^7.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@j-alicia-long/web-config": "github:j-alicia-long/web-config#v0.1.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.2.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.119.0"
  }
}
